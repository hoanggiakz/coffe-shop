# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password-prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-jwt-secret-2026
JWT_EXPIRATION=86400000
INTERNAL_SERVICE_TOKEN=replace-with-long-random-internal-service-token-2026

# ── User Service (Spring Boot :3000) ──────────────────
USER_DB_URL=jdbc:postgresql://postgres:5432/userdb
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=change-this-postgres-password-prod

# ── Table Service (Spring Boot :3003) ─────────────────
TABLE_DB_URL=jdbc:postgresql://postgres:5432/tabledb
TABLE_DB_USERNAME=postgres
TABLE_DB_PASSWORD=change-this-postgres-password-prod
QR_BASE_URL=https://localhost/menu

# ── Order Service (NestJS :3001) ──────────────────────
ORDER_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/orderdb?schema=public

# ── Chat Service (NestJS :3007) ───────────────────────
CHAT_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/chatdb?schema=public

# ── Inventory / Payment / Report DB URLs ──────────────
INVENTORY_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/inventorydb?schema=public
PAYMENT_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/paymentdb?schema=public
REPORT_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/reportdb?schema=public
REPORT_USER_DATABASE_URL=postgresql://postgres:change-this-postgres-password-prod@postgres:5432/userdb?schema=public

# ── API Gateway (NestJS :8080) ────────────────────────
USER_SERVICE_URL=http://user-service:3000
TABLE_SERVICE_URL=http://table-service:3003
ORDER_SERVICE_URL=http://order-service:3001
CHAT_SERVICE_URL=http://chat-service:3007
INVENTORY_SERVICE_URL=http://inventory-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3004
REPORT_SERVICE_URL=http://report-service:3006

# ── Frontend (React/Vite) ──────────────────────────
VITE_API_URL=/api
VITE_WS_URL=https://localhost
NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_WS_URL=https://localhost
ALLOWED_ORIGINS=https://localhost
APP_BASE_URL=https://localhost

# ── SMTP / Notification ─────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@coffee.example.com
SMTP_PASS=replace-this-smtp-password
SMTP_FROM=Coffee Shop <noreply@coffee.example.com>

# ── VietQR ───────────────────────────────────────────
ONLINE_PAYMENT_QR_URL=https://img.vietqr.io/image/VCB-1026422235-qr_only.png

# ── VNPay / MoMo (optional) ──────────────────────────
VNPAY_PAY_URL=
VNPAY_TMN_CODE=
MOMO_PAY_URL=
MOMO_PARTNER_CODE=

# ── Optional host port/bind settings (single compose) ─────
DOCKER_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_GATEWAY_HOST_PORT=8080
CHAT_SERVICE_HOST_PORT=3007
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
SEED_TABLES_ON_STARTUP=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# ── Optional profiles: monitoring/logging ─────────────────
# COMPOSE_PROFILES=monitoring,logging
