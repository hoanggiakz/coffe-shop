# ── Runtime ───────────────────────────────────────────
NODE_ENV=production

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Kafka ─────────────────────────────────────
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=

# ── Auth / Internal ───────────────────────────────────
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRATION=86400000
INTERNAL_SERVICE_TOKEN=CHANGE_ME_STRONG_INTERNAL_TOKEN

# ── User Service (Spring Boot :3000) ──────────────────
USER_DB_URL=jdbc:postgresql://postgres:5432/userdb
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=postgres

# ── Table Service (Spring Boot :3003) ─────────────────
TABLE_DB_URL=jdbc:postgresql://postgres:5432/tabledb
TABLE_DB_USERNAME=postgres
TABLE_DB_PASSWORD=postgres
APP_BASE_URL=https://app.httpscoffee-demo.buzz
SEED_TABLES_ON_STARTUP=false
MENU_QR_ALLOW_BRANCH_ONLY_TEST=false

# ── Order Service (NestJS :3001) ──────────────────────
ORDER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orderdb?schema=public

# ── Chat Service (NestJS :3007) ───────────────────────
CHAT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatdb?schema=public

# ── Inventory / Payment / Report DB URLs ──────────────
INVENTORY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/inventorydb?schema=public
PAYMENT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/paymentdb?schema=public
REPORT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/reportdb?schema=public
REPORT_USER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/userdb?schema=public

# ── Service Discovery (Docker network) ────────────────
USER_SERVICE_URL=http://user-service:3000
TABLE_SERVICE_URL=http://table-service:3003
ORDER_SERVICE_URL=http://order-service:3001
CHAT_SERVICE_URL=http://chat-service:3007
INVENTORY_SERVICE_URL=http://inventory-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3004
REPORT_SERVICE_URL=http://report-service:3006
AI_SERVICE_URL=http://ai-service:3010

# ── Frontend / CORS ───────────────────────────────────
VITE_API_URL=/api
VITE_WS_URL=
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=
ALLOWED_ORIGINS=https://app.httpscoffee-demo.buzz,http://192.168.56.106:8088,http://localhost:8088

# ── SMTP / Notification ───────────────────────────────
LOW_STOCK_ALERT_EMAILS=manager@coffeeshop.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@coffee.example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Coffee Shop <noreply@coffee.example.com>

# ── Online Payment QR ─────────────────────────────────
ONLINE_PAYMENT_QR_URL=https://coffee.example.com/sepay-qr.png
ONLINE_PAYMENT_QR_ACCOUNT_NAME=Coffee Shop
ONLINE_PAYMENT_QR_ACCOUNT_NO=1026422235
ONLINE_PAYMENT_QR_BANK_CODE=VCB
ONLINE_PAYMENT_QR_BANK_NAME=
ONLINE_PAYMENT_TIMEOUT_MINUTES=30

# ── Payment Providers (optional) ──────────────────────
VNPAY_PAY_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_QUERY_URL=
VIETQR_QUERY_URL=

# ── Webhook / SePay (optional) ────────────────────────
PAYMENT_WEBHOOK_SECRET=
VNPAY_WEBHOOK_SECRET=
VIETQR_WEBHOOK_SECRET=
SEPAY_ENV=production
SEPAY_QUERY_URL=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_IPN_API_KEY=
SEPAY_IPN_AUTH_TYPE=apikey

# ── SePay Relay (fixed endpoint + local pull) ─────────
SEPAY_RELAY_SHARED_SECRET=
SEPAY_RELAY_BUFFER_SIZE=1000
SEPAY_RELAY_PULL_ENABLED=false
SEPAY_RELAY_SOURCE_URL=
SEPAY_RELAY_PULL_INTERVAL_MS=3000
SEPAY_RELAY_CONSUMER_ID=coffee-prod-vm

# ── Host bind / ports (single compose) ────────────────
DOCKER_BIND_IP=0.0.0.0
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_GATEWAY_HOST_PORT=8080
CHAT_SERVICE_HOST_PORT=3007
FRONTEND_HTTP_PORT=8088
FRONTEND_HTTPS_PORT=443

# ── Backup ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# ── Optional profiles: monitoring/logging ─────────────
# COMPOSE_PROFILES=monitoring,logging
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3008
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
ELASTICSEARCH_HOST_PORT=9200
LOGSTASH_BEATS_HOST_PORT=5044
LOGSTASH_TCP_HOST_PORT=5000
KIBANA_HOST_PORT=5601

# ── AI stack (optional profile: ai) ───────────────────────
AI_MODEL_REGISTRY_URL=http://mlflow:5000
AI_LLM_PROVIDER=openai
AI_LLM_API_KEY=
AI_CHATBOT_SQL_TIMEOUT_MS=2000
AI_CHATBOT_MAX_ROWS=200
AI_ROLLOUT_PERCENT=10
AI_ACTIVE_MODEL_VERSION=baseline_v1
AI_STAGING_MODEL_VERSION=baseline_v2_candidate
AI_RETENTION_FORECAST_DAYS=180
AI_RETENTION_ANOMALY_DAYS=365
AI_RETENTION_CHATLOG_DAYS=90
DEBEZIUM_DB_USER=postgres
DEBEZIUM_DB_PASSWORD=postgres
DEBEZIUM_TOPIC_PREFIX=coffeeshop
