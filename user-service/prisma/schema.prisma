generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  phone     String?
  createdAt DateTime @default(now())

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}
