generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  WAITING_TRANSFER
  WAITING_CASH
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model Payment {
  id        String         @id @default(cuid())
  orderId   String         @unique
  tableId   String?
  amount    Decimal
  status    PaymentStatus  @default(PENDING)
  provider  String         // "VIETQR" | "CASH" | "VNPAY"
  transactionId String?
  transferContent String?
  metadata  Json?
  paidAt    DateTime?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("payments")
  @@index([orderId])
  @@index([status])
  @@index([provider])
}
