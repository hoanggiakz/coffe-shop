REPORT_DATABASE_URL=postgresql://postgres:password@localhost:5432/reportdb
CHAT_SERVICE_API_URL=http://chat-service:3007/api/chats

AI_CHATBOT_SQL_TIMEOUT_MS=2000
AI_CHATBOT_MAX_ROWS=200

AI_ROLLOUT_PERCENT=10
AI_ACTIVE_MODEL_VERSION=baseline_v1
AI_STAGING_MODEL_VERSION=baseline_v2_candidate

AI_KB_REFRESH_INTERVAL_MINUTES=30
AI_FORECAST_CRON_ENABLED=true
AI_FORECAST_CRON_HOUR_UTC=19

AI_ENFORCE_RBAC=false
AI_ALLOW_LEGACY_NO_AUTH=true

AI_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_REPORT_CHAT_PER_MINUTE=30
AI_RATE_LIMIT_CHAT_PER_MINUTE=60
