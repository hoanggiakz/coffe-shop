generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id        String         @id @default(cuid())
  branchId  String?
  name      String
  unit      String         // e.g. "kg", "liter", "piece"
  stock     Decimal        @default(0)
  minStock  Decimal        @default(0)
  importPrice Decimal      @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  movements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
  @@unique([branchId, name])
  @@index([branchId])
  @@index([branchId, name])
  @@index([name])
  @@index([isActive])
}

model Recipe {
  id           String   @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal
  wastageRate  Decimal  @default(0)
  createdAt    DateTime @default(now())

  @@map("recipes")
  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model BranchRecipe {
  id           String   @id @default(cuid())
  branchId     String
  menuItemId   String
  ingredientId String
  quantity     Decimal
  wastageRate  Decimal  @default(0)
  createdAt    DateTime @default(now())

  @@map("branch_recipes")
  @@unique([branchId, menuItemId, ingredientId])
  @@index([branchId, menuItemId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  branchId     String
  supplierName String
  totalAmount  Decimal             @default(0)
  status       PurchaseOrderStatus @default(DRAFT)
  receivedAt   DateTime?
  notes        String?
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]

  @@map("purchase_orders")
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Decimal
  unitPrice       Decimal
  expiryDate      DateTime?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model StockMovement {
  id          String     @id @default(cuid())
  ingredientId String
  branchId     String?
  type        StockType
  source      StockSource @default(MANUAL)
  quantity    Decimal
  unitPrice   Decimal     @default(0)
  totalPrice  Decimal     @default(0)
  reason      String?
  note        String?
  referenceCode String?
  beforeStock Decimal     @default(0)
  afterStock  Decimal     @default(0)
  createdBy   String?
  createdAt   DateTime   @default(now())
  ingredient  Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
  @@index([ingredientId])
  @@index([branchId])
  @@index([branchId, createdAt])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}

enum StockType {
  IMPORT
  EXPORT
  ADJUST
}

enum StockSource {
  MANUAL
  RECEIPT
  ORDER
  STOCKTAKE
  SYNC_MENU
  SYSTEM
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}
